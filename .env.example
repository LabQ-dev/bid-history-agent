# 공공데이터포털(data.go.kr) 인증키 — "Decoding" 키를 사용
# 활용신청: 조달청_나라장터 낙찰정보서비스 (https://www.data.go.kr/data/15129397/openapi.do)
G2B_SERVICE_KEY="YOUR_SERVICE_KEY"

# ── 웹 서버(web.py) 설정 ─────────────────────────────
# 사무실 공용 컴퓨터 등에서 다른 사람도 접속하게 하려면 아래 두 줄의 주석(#)을 해제
# WEB_HOST=0.0.0.0
# WEB_PASSWORD="팀공용비밀번호"
# WEB_PORT=8931

# ── 개찰결과 일일 수집기(collector.py) 설정 ──────────
# COLLECT_HOUR=6          # --daemon 모드 수집 시각 (매일 06시)
# COLLECT_MAX_CALLS=8000  # 1회 수집 최대 API 호출수 (일일한도 보호)
# COLLECT_LOOKBACK_DAYS=7 # 데몬이 매일 재확인할 최근 일수 (뒤늦게 등록되는 개찰결과 대응)

# WEB_DB_ONLY=1          # 웹 검색을 DB 전용으로(기본). 0이면 미수집분을 API로 채우며 검색
